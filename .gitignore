# Môi trường, thông tin đăng nhập và bộ nhớ đệm
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
.env.*
!.env.example
~$*
*.log
*.pt
*.pth
*.ckpt

# Dữ liệu sinh ra và tài liệu kiểm tra bố cục tại máy
/results/
/scratch/
/output/
/experiments/archive/
/experiments/leaderboard_inspection/

# Phản hồi API, trạng thái từng ngày, replay và bài nộp
/experiments/data/api_evidence/*
!/experiments/data/api_evidence/summary.json
!/experiments/data/api_evidence/manifest.json
/experiments/data/legacy_branch_evidence/*
!/experiments/data/legacy_branch_evidence/summary.json
/experiments/data/rl_branch_evidence/*
!/experiments/data/rl_branch_evidence/summary.json
!/experiments/data/rl_branch_evidence/model_metadata.json
/experiments/data/team_selection_api_evidence/*
!/experiments/data/team_selection_api_evidence/summary.json
/experiments/data/team_selection_results/*
!/experiments/data/team_selection_results/summary.json
!/experiments/data/team_selection_results/metadata.json
!/experiments/data/team_selection_results/upper_bounds.json
/examples/demo_replay.json
/examples/types.json

# Tài liệu BTC tải thêm tại máy; giữ đề và input mẫu đã có trong repo
/Đề bài/Techinical_Presentation.pptx
/docs/api/sample_games.json

# Thử nghiệm RL mở rộng: giữ tổng hợp, không đưa mọi kế hoạch/ngày lên GitHub.
/experiments/data/rl_extension_results/*
!/experiments/data/rl_extension_results/summary.json
!/experiments/data/rl_extension_results/metadata.json
!/experiments/data/rl_extension_results/audit.json
/experiments/data/rl_extension_api_evidence/*
!/experiments/data/rl_extension_api_evidence/summary.json

# RL học lại: lưu số liệu tổng hợp, bỏ checkpoint và mọi output chi tiết.
/experiments/data/rl_policy_results/*
!/experiments/data/rl_policy_results/training_metadata.json
!/experiments/data/rl_policy_results/evaluation_summary.json
!/experiments/data/rl_policy_results/evaluation_audit.json

# Tour: giữ tổng hợp điểm BTC, không đưa replay và lịch sử chi tiết lên Git.
/experiments/data/tour_api_evidence/*
!/experiments/data/tour_api_evidence/summary.json
